# ============================================================
# Copy file nay thanh .env  ->  copy .env.example .env
# ============================================================

# --- Vi tri cache model (TUY CHON) ---
# De trong / xoa dong nay = dung thu muc mac dinh cua he dieu hanh:
#   Windows: %USERPROFILE%\.cache\huggingface
#   Linux  : ~/.cache/huggingface
# Chi dat gia tri neu o he thong cua ban sap day.
# Can khoang 4 GB cho SD1.5 + ControlNet (ban fp16).
#
# HF_HOME=D:\AI_Models\huggingface

# --- Model IDs ---
# Khoa lai de Baseline va Proposed dung chung 1 model (yeu cau spec muc 16).
# Dung repo chinh thuc: runwayml/stable-diffusion-v1-5 da bi go khoi Hub nam 2024.
SD15_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
CONTROLNET_CANNY_ID=lllyasviel/control_v11p_sd15_canny

# --- Giam phan manh bo nho VRAM tren GPU 8GB ---
# expandable_segments CHI hoat dong tren Linux - tren Windows PyTorch bo qua
# va in warning. Bat lai neu chuyen sang chay Linux.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- API bridge / production ---
# Domain frontend được phép gọi API. Phân tách nhiều domain bằng dấu phẩy.
WEB_UI_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Domain API cần đặt tương ứng trong web_ui/assets/js/config.js khi deploy.
# WEB_UI_API_BASE=https://api.example.com
