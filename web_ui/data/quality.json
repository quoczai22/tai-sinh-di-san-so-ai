y":"Phương sai Laplacian trong vùng họa tiết so với bản ghép. Polish làm nhoè nét mảnh thì tụt (khoá họa tiết cũ đo 0,56 đến 0,61, xem evaluation/polish_finish_trial.csv); PPS không bắt được vì chỉ đo dải tần trung."},"palette_shift_de":{"label":"Lệch bảng màu họa tiết (ΔE)","direction":"lower_is_better","warn":10.0,"fail":20.0,"why":"ΔE76 giữa màu trung bình vùng họa tiết. ΔE ≈ 10 là khác màu thấy rõ khi đặt cạnh nhau."}},"routing":{"pattern_preservation":{"route_to":"stage2_repair","action":"Khoá họa tiết (pattern-lock) hoặc giảm strength img2img 0,40 → 0,25; nếu vẫn không đạt, dùng bản ghép tất định."},"garment_shape_iou":{"route_to":"stage2_repair","action":"Giảm strength img2img hoặc dùng bản ghép tất định (dáng áo đúng tuyệt đối)."},"sharpness_ratio":{"route_to":"stage2_repair","action":"Giảm strength img2img hoặc tăng số bước."},"detail_ratio":{"route_to":"stage2_repair","action":"Khoá họa tiết với dog_sigma_low nhỏ (0,3) hoặc giảm strength polish."},"palette_shift_de":{"route_to":"stage2_repair","action":"Khoá họa tiết (giữ sắc độ bản ghép)."}}}},"decision":{"PASS":"Đủ điều kiện chuyển chuyên gia thẩm định.","WARN":"QC Officer xem xét trước khi chuyển chuyên gia (có thể chuyển kèm ghi chú).","FAIL":"Không chuyển chuyên gia. Hệ thống đề xuất bước quay lại; tối đa 3 lần sinh lại/sửa cho một thiết kế, quá 3 lần thì chuyển Nhà thiết kế quyết định."},"max_retries":3}}