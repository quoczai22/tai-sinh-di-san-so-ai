{
  "cleanUrls": true,
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/status.js": { "maxDuration": 60 },
    "api/media.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
