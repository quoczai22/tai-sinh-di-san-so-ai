<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP01a" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP01a" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:error id="Error_1" name="VARIANT_FAILED" errorCode="VARIANT_FAILED" />
  <bpmn:collaboration id="Collab_BP01a">
    <bpmn:participant id="P" name="Pipeline AI" processRef="Proc_P" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Pipeline AI" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_AI" name="Sinh ảnh">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_QG" name="Cổng chất lượng tự động">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Bắt đầu một phương án">
      <bpmn:outgoing>Flow_S_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Sinh hoa văn">
      <bpmn:incoming>Flow_S_T1</bpmn:incoming>
      <bpmn:incoming>Flow_T3_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BE" name="Lỗi GPU hoặc mô hình" attachedToRef="T1">
      <bpmn:outgoing>Flow_BE_E_ERR</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_BE" errorRef="Error_1" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E_ERR" name="Phương án lỗi">
      <bpmn:incoming>Flow_BE_E_ERR</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_E_ERR" errorRef="Error_1" />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="T2" name="Cổng G2">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G1" name="Kết quả G2?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_M1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Đổi seed, sinh lại">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_T1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Giữ bản ít lỗi nhất, gắn cờ không đạt">
      <bpmn:incoming>Flow_G1_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_M1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_G1_M1</bpmn:incoming>
      <bpmn:incoming>Flow_T4_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_T5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T5" name="Chọn bố cục, ghép hoa văn lên áo">
      <bpmn:incoming>Flow_M1_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T6" name="Hoàn thiện vùng áo">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:incoming>Flow_T8_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_T7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T7" name="Cổng G3">
      <bpmn:incoming>Flow_T6_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_G2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G2" name="Kết quả G3?">
      <bpmn:incoming>Flow_T7_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_M2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T8</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T8" name="Đổi seed, hạ độ nhiễu">
      <bpmn:incoming>Flow_G2_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_T6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T9" name="Dùng bản ghép thô">
      <bpmn:incoming>Flow_G2_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_M2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_G2_M2</bpmn:incoming>
      <bpmn:incoming>Flow_T9_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_M2_E</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E" name="Phương án hoàn tất">
      <bpmn:incoming>Flow_M2_E</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T1" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_T2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_BE_E_ERR" name="" sourceRef="BE" targetRef="E_ERR" />
    <bpmn:sequenceFlow id="Flow_T2_G1" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_M1" name="Đạt / cảnh báo" sourceRef="G1" targetRef="M1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">G2 ∈ {PASS, WARN}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_T3" name="Lỗi, dưới 3 lần" sourceRef="G1" targetRef="T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">G2 = FAIL và số lần &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T3_T1" name="" sourceRef="T3" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_G1_T4" name="Lỗi, đủ 3 lần" sourceRef="G1" targetRef="T4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">G2 = FAIL và số lần = 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_M1" name="" sourceRef="T4" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_M1_T5" name="" sourceRef="M1" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_T5_T6" name="" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_T7" name="" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_T7_G2" name="" sourceRef="T7" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_M2" name="Đạt / cảnh báo" sourceRef="G2" targetRef="M2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">G3 ∈ {PASS, WARN}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_T8" name="Lỗi, còn lượt" sourceRef="G2" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">G3 = FAIL và còn lượt thử</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T8_T6" name="" sourceRef="T8" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_G2_T9" name="Lỗi, hết lượt" sourceRef="G2" targetRef="T9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">G3 = FAIL và hết lượt thử</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T9_M2" name="" sourceRef="T9" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_M2_E" name="" sourceRef="M2" targetRef="E" />
  </bpmn:process>
