<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP01" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP01" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:error id="Error_1" name="ALL_VARIANTS_FAILED" errorCode="ALL_VARIANTS_FAILED" />
  <bpmn:error id="Error_2" name="JOB_FAILED" errorCode="JOB_FAILED" />
  <bpmn:error id="Error_3" name="RIGHTS_DENIED" errorCode="RIGHTS_DENIED" />
  <bpmn:dataStore id="Store_DS" name="Kho Design Passport" />
  <bpmn:collaboration id="Collab_BP01">
    <bpmn:participant id="P" name="Nền tảng Tái Sinh Di Sản Số" processRef="Proc_P" />
    <bpmn:participant id="OPS" name="Người vận hành (Zalo)" />
    <bpmn:messageFlow id="Msg_T11_OPS" name="Cảnh báo hàng chờ đầy" sourceRef="T11" targetRef="OPS" />
    <bpmn:messageFlow id="Msg_T12_OPS" name="Cảnh báo job thất bại" sourceRef="T12" targetRef="OPS" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Nền tảng Tái Sinh Di Sản Số" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_USR" name="Nhà thiết kế (web)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GW" name="Ứng dụng web, cổng Vercel">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_API" name="API và pipeline AI (GPU Modal)">
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Cần một thiết kế áo dài">
      <bpmn:outgoing>Flow_S1_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Chọn hiện vật, xem mô hình 3D và sổ hoa văn">
      <bpmn:incoming>Flow_S1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Bấm Tạo thiết kế">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Máy GPU sẵn sàng?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_T4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Trả bộ thiết kế sinh sẵn, ghi nhãn &#34;đã sinh sẵn&#34;">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_M1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T4" name="Chuyển yêu cầu sinh tới API (10 lượt/giờ/IP)">
      <bpmn:incoming>Flow_G1_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_G2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Trong hạn mức, hàng chờ còn chỗ?">
      <bpmn:incoming>Flow_T4_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_T5</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T11" name="Trả lỗi 429, cảnh báo vận hành">
      <bpmn:incoming>Flow_G2_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T11_E1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Không tạo được (thử lại sau)">
      <bpmn:incoming>Flow_T11_E1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T5" name="Xếp hàng chờ GPU (tối đa 3 lượt)">
      <bpmn:incoming>Flow_G2_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T6" name="Kiểm tra quyền mục đích &#34;thử nghiệm&#34;">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_G3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G3" name="Được phép?">
      <bpmn:incoming>Flow_T6_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_T7</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_E2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Hiện vật không được dùng">
      <bpmn:incoming>Flow_G3_E2</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_E2" errorRef="Error_3" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T7" name="Chuẩn bị hoa văn: tách nền, Canny, bảng màu">
      <bpmn:incoming>Flow_G3_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_T8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T8" name="Sinh áo dài nền (LoRA), tách vùng áo (SAM)">
      <bpmn:incoming>Flow_T7_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_SP</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SP" name="Tạo 4 phương án (BP-01a)">
      <bpmn:incoming>Flow_T8_SP</bpmn:incoming>
      <bpmn:outgoing>Flow_SP_T9</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BE" name="Không phương án nào thành công" attachedToRef="SP">
      <bpmn:outgoing>Flow_BE_T12</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_BE" errorRef="Error_1" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="T12" name="Báo lỗi trên trang, cảnh báo vận hành">
      <bpmn:incoming>Flow_BE_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T12_E3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E3" name="Tạo thiết kế thất bại">
      <bpmn:incoming>Flow_T12_E3</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_E3" errorRef="Error_2" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T9" name="Lập Design Passport cho từng phương án">
      <bpmn:incoming>Flow_SP_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_T10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T10" name="Gán trạng thái duyệt theo kết quả G2, G3">
      <bpmn:incoming>Flow_T9_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_M1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_T10_DS">
        <bpmn:targetRef>DS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="DS" name="Kho Design Passport" dataStoreRef="Store_DS" />
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_T10_M1</bpmn:incoming>
      <bpmn:incoming>Flow_T3_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_T13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T13" name="Xem 4 thiết kế ở trang Kết quả">
      <bpmn:incoming>Flow_M1_T13</bpmn:incoming>
      <bpmn:outgoing>Flow_T13_E4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E4" name="Bộ thiết kế sẵn sàng (sang BP-02)">
      <bpmn:incoming>Flow_T13_E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S1_T1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_T2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_T2_G1" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_T4" name="Có" sourceRef="G1" targetRef="T4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">health.generation_available = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_T3" name="Không" sourceRef="G1" targetRef="T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">health.generation_available = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_G2" name="" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_T5" name="Trong hạn mức" sourceRef="G2" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lượt trong giờ &lt; 6 và hàng chờ &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_T11" name="Vượt hạn mức" sourceRef="G2" targetRef="T11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lượt trong giờ ≥ 6 hoặc hàng chờ đầy</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T11_E1" name="" sourceRef="T11" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_T5_T6" name="" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_G3" name="" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_T7" name="Được phép" sourceRef="G3" targetRef="T7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_gate(experiment).allowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_E2" name="Bị từ chối" sourceRef="G3" targetRef="E2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_status = permission_denied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_T8" name="" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_T8_SP" name="" sourceRef="T8" targetRef="SP" />
    <bpmn:sequenceFlow id="Flow_SP_T9" name="" sourceRef="SP" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_T9_T10" name="" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_BE_T12" name="" sourceRef="BE" targetRef="T12" />
    <bpmn:sequenceFlow id="Flow_T12_E3" name="" sourceRef="T12" targetRef="E3" />
    <bpmn:sequenceFlow id="Flow_T10_M1" name="" sourceRef="T10" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_T3_M1" name="" sourceRef="T3" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_M1_T13" name="" sourceRef="M1" targetRef="T13" />
    <bpmn:sequenceFlow id="Flow_T13_E4" name="" sourceRef="T13" targetRef="E4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP01" name="BP-01 — Tạo thiết kế áo dài (AS-IS, giữ nguyên ở TO-BE)">
