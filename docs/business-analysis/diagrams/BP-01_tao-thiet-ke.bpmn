      <bpmndi:BPMNEdge id="Flow_S1_T1_di" bpmnElement="Flow_S1_T1">
        <di:waypoint x="128" y="176" />
        <di:waypoint x="128" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T1_T2_di" bpmnElement="Flow_T1_T2">
        <di:waypoint x="128" y="332" />
