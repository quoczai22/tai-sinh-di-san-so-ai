<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP00_TOBE" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP00_TOBE" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:dataStore id="Store_DS_H" name="Danh mục hiện vật (metadata.json)" />
  <bpmn:dataStore id="Store_DS_P" name="Kho Design Passport" />
  <bpmn:collaboration id="Collab_BP00_TOBE">
    <bpmn:participant id="OWN" name="Chủ sở hữu ảnh / bộ dữ liệu" />
    <bpmn:participant id="P" name="Nền tảng Tái Sinh Di Sản Số" processRef="Proc_P" />
    <bpmn:participant id="EXP" name="Hội đồng chuyên gia" />
    <bpmn:messageFlow id="Msg_C4_OWN" name="Đề nghị cấp phép (khi quyền chưa rõ)" sourceRef="C4" targetRef="OWN" />
    <bpmn:messageFlow id="Msg_C3_EXP" name="Gói / link chấm mù" sourceRef="C3" targetRef="EXP" />
    <bpmn:messageFlow id="Msg_EXP_C3" name="Phiếu chấm" sourceRef="EXP" targetRef="C3" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Nền tảng Tái Sinh Di Sản Số" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_DATA" name="Người quản lý dữ liệu">
        <bpmn:flowNodeRef>S_D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_D</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_USR" name="Nhà thiết kế (web)">
        <bpmn:flowNodeRef>S_U</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_U</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Hệ thống (web, API, pipeline AI)">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Q</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_QC" name="QC Officer" />
    </bpmn:laneSet>
    <bpmn:startEvent id="S_D" name="Có hiện vật mới">
      <bpmn:outgoing>Flow_S_D_C4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="C4" name="BP-04 Tiếp nhận hiện vật, quản lý quyền">
      <bpmn:incoming>Flow_S_D_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C4_E_D</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_C4_DS_H">
        <bpmn:targetRef>DS_H</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:endEvent id="E_D" name="Hiện vật có trên Studio">
      <bpmn:incoming>Flow_C4_E_D</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_H" name="Danh mục hiện vật (metadata.json)" dataStoreRef="Store_DS_H" />
    <bpmn:startEvent id="S_U" name="Cần một thiết kế">
      <bpmn:outgoing>Flow_S_U_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="C1" name="BP-01 Tạo thiết kế áo dài">
      <bpmn:incoming>Flow_S_U_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C1_C2</bpmn:outgoing>
      <bpmn:property id="Prop_C1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Data_DS_H_C1">
        <bpmn:sourceRef>DS_H</bpmn:sourceRef>
        <bpmn:targetRef>Prop_C1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Data_C1_DS_P">
        <bpmn:targetRef>DS_P</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:callActivity id="C2" name="BP-02 Xem, tải, chỉnh sửa thiết kế">
      <bpmn:incoming>Flow_C1_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C2_E_U</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_C2_DS_P">
        <bpmn:targetRef>DS_P</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:callActivity>
    <bpmn:endEvent id="E_U" name="Kết thúc phiên thiết kế">
      <bpmn:incoming>Flow_C2_E_U</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_P" name="Kho Design Passport" dataStoreRef="Store_DS_P" />
    <bpmn:startEvent id="S_Q" name="Thiết kế đổi trạng thái duyệt">
      <bpmn:outgoing>Flow_S_Q_C3</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_S_Q">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">approval.status thay đổi</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:callActivity id="C3" name="BP-03 Kiểm soát chất lượng, thẩm định, xuất bản">
      <bpmn:incoming>Flow_S_Q_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C3_E_Q</bpmn:outgoing>
      <bpmn:property id="Prop_C3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Data_DS_P_C3">
        <bpmn:sourceRef>DS_P</bpmn:sourceRef>
        <bpmn:targetRef>Prop_C3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:endEvent id="E_Q" name="Thiết kế có kết luận">
      <bpmn:incoming>Flow_C3_E_Q</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_D_C4" name="" sourceRef="S_D" targetRef="C4" />
    <bpmn:sequenceFlow id="Flow_C4_E_D" name="" sourceRef="C4" targetRef="E_D" />
    <bpmn:sequenceFlow id="Flow_S_U_C1" name="" sourceRef="S_U" targetRef="C1" />
    <bpmn:sequenceFlow id="Flow_C1_C2" name="" sourceRef="C1" targetRef="C2" />
    <bpmn:sequenceFlow id="Flow_C2_E_U" name="" sourceRef="C2" targetRef="E_U" />
    <bpmn:sequenceFlow id="Flow_S_Q_C3" name="" sourceRef="S_Q" targetRef="C3" />
    <bpmn:sequenceFlow id="Flow_C3_E_Q" name="" sourceRef="C3" targetRef="E_Q" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP00_TOBE" name="BP-00 TO-BE — Bản đồ quy trình">
    <bpmndi:BPMNPlane id="Plane_BP00_TOBE" bpmnElement="Collab_BP00_TOBE">
