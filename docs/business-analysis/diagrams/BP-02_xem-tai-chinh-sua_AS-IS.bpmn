<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP02_ASIS" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP02_ASIS" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:dataStore id="Store_DS" name="Kho Design Passport" />
  <bpmn:collaboration id="Collab_BP02_ASIS">
    <bpmn:participant id="P" name="Nền tảng Tái Sinh Di Sản Số" processRef="Proc_P" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Nền tảng Tái Sinh Di Sản Số" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_USR" name="Nhà thiết kế (web)">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_CANCEL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_END</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_END</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GW" name="Ứng dụng web, cổng Vercel">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_LOCK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_API" name="API và kho Passport">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Mở trang Kết quả hoặc Thiết kế đã tạo">
      <bpmn:outgoing>Flow_S_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Phóng to một thiết kế">
      <bpmn:incoming>Flow_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_G1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Muốn làm gì?">
      <bpmn:incoming>Flow_T1_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_M_END</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_G2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2" name="Bấm Tải xuống">
      <bpmn:incoming>Flow_G1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_T3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="T3" name="In nhãn &#34;Hỗ trợ bởi AI&#34; lên ảnh, lưu PNG (trình duyệt)">
      <bpmn:incoming>Flow_T2_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_E_DL</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="E_DL" name="Đã tải ảnh có nhãn AI">
      <bpmn:incoming>Flow_T3_E_DL</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G2" name="Thiết kế tạo trực tiếp trên máy chủ?">
      <bpmn:incoming>Flow_G1_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_T4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T4" name="Khoá nút Tải lên chỉnh sửa, nêu lý do">
      <bpmn:incoming>Flow_G2_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_E_LOCK</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_LOCK" name="Không chỉnh sửa được (thiết kế sinh sẵn)">
      <bpmn:incoming>Flow_T4_E_LOCK</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T5" name="Sửa ảnh bằng công cụ đồ họa">
      <bpmn:incoming>Flow_G2_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="T6" name="Tải PNG lên, khai báo ID TSDS, vai trò, nội dung, công cụ">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:incoming>Flow_G4_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_G3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Lưu hay huỷ?">
      <bpmn:incoming>Flow_T6_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_E_CANCEL</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_T7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_CANCEL" name="Huỷ, không lưu bản sửa">
      <bpmn:incoming>Flow_G3_E_CANCEL</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="T7" name="Kiểm tra PNG ≤ 3 MB, cạnh ≤ 4096 px, 5 lượt/giờ/IP">
      <bpmn:incoming>Flow_G3_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_G4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G4" name="Hợp lệ?">
      <bpmn:incoming>Flow_T7_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_T6</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_T8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T8" name="Lưu phiên bản mới (SHA-256) vào Passport">
      <bpmn:incoming>Flow_G4_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_T9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_T8_DS">
        <bpmn:targetRef>DS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T9" name="Chạy cổng G3 cho bản sửa, cập nhật trạng thái duyệt">
      <bpmn:incoming>Flow_T8_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_T10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_T9_DS">
        <bpmn:targetRef>DS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="DS" name="Kho Design Passport" dataStoreRef="Store_DS" />
    <bpmn:userTask id="T10" name="Xem thông báo &#34;Đã cập nhật&#34;, nhãn &#34;Đã chỉnh sửa&#34;">
      <bpmn:incoming>Flow_T9_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_M_END</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_END" name="">
      <bpmn:incoming>Flow_G1_M_END</bpmn:incoming>
      <bpmn:incoming>Flow_T10_M_END</bpmn:incoming>
      <bpmn:outgoing>Flow_M_END_E_END</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_END" name="Kết thúc">
      <bpmn:incoming>Flow_M_END_E_END</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T1" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_G1" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_T2" name="Tải xuống" sourceRef="G1" targetRef="T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">người dùng bấm Tải xuống</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T2_T3" name="" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T3_E_DL" name="" sourceRef="T3" targetRef="E_DL" />
    <bpmn:sequenceFlow id="Flow_G1_M_END" name="Xong" sourceRef="G1" targetRef="M_END">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">người dùng đóng cửa sổ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_G2" name="Chỉnh sửa" sourceRef="G1" targetRef="G2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">người dùng bấm Tải lên chỉnh sửa</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_T4" name="Không" sourceRef="G2" targetRef="T4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">thiết kế thuộc bộ sinh sẵn</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_E_LOCK" name="" sourceRef="T4" targetRef="E_LOCK" />
    <bpmn:sequenceFlow id="Flow_G2_T5" name="Có" sourceRef="G2" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">có Passport trên máy chủ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T5_T6" name="" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_G3" name="" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_E_CANCEL" name="Huỷ" sourceRef="G3" targetRef="E_CANCEL">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">người dùng bấm Huỷ và xác nhận</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_T7" name="Lưu" sourceRef="G3" targetRef="T7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">người dùng xác nhận lưu</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_G4" name="" sourceRef="T7" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_G4_T6" name="Không hợp lệ: báo lỗi" sourceRef="G4" targetRef="T6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tệp hoặc trường sai, vượt hạn mức</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G4_T8" name="Hợp lệ" sourceRef="G4" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mọi kiểm tra đạt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T8_T9" name="" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_T9_T10" name="" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_T10_M_END" name="" sourceRef="T10" targetRef="M_END" />
    <bpmn:sequenceFlow id="Flow_M_END_E_END" name="" sourceRef="M_END" targetRef="E_END" />
  </bpmn:process>
