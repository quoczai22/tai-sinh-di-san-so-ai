<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP03_TOBE" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP03_TOBE" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:dataStore id="Store_DS" name="Kho Design Passport" />
  <bpmn:dataStore id="Store_DS2" name="Kho Design Passport" />
  <bpmn:collaboration id="Collab_BP03_TOBE">
    <bpmn:participant id="P" name="Nền tảng Tái Sinh Di Sản Số" processRef="Proc_P" />
    <bpmn:participant id="EXP" name="Hội đồng chuyên gia" processRef="Proc_EXP">
      <bpmn:participantMultiplicity minimum="2" maximum="5" />
    </bpmn:participant>
    <bpmn:messageFlow id="Msg_T4_ES" name="Link phiếu chấm mù" sourceRef="T4" targetRef="ES" />
    <bpmn:messageFlow id="Msg_EE_IC1" name="Phiếu chấm" sourceRef="EE" targetRef="IC1" />
    <bpmn:messageFlow id="Msg_T5_EXP" name="Lời nhắc" sourceRef="T5" targetRef="EXP" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Nền tảng Tái Sinh Di Sản Số" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_QC" name="QC Officer">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Hệ thống">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Thiết kế đổi trạng thái duyệt hoặc được đề cử">
      <bpmn:outgoing>Flow_S_T1</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_S">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">approval.status thay đổi hoặc có đề cử</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="T1" name="Định tuyến theo trạng thái duyệt">
      <bpmn:incoming>Flow_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_G1</bpmn:outgoing>
      <bpmn:property id="Prop_T1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Data_DS_T1">
        <bpmn:sourceRef>DS</bpmn:sourceRef>
        <bpmn:targetRef>Prop_T1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="DS" name="Kho Design Passport" dataStoreRef="Store_DS" />
    <bpmn:exclusiveGateway id="G1" name="Trạng thái?">
      <bpmn:incoming>Flow_T1_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_E1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Chờ sửa">
      <bpmn:incoming>Flow_G1_E1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T2" name="Xử lý cảnh báo trên bảng QC">
      <bpmn:incoming>Flow_G1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Quyết định&#10;QC?">
      <bpmn:incoming>Flow_T2_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_E2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Trả về sửa">
      <bpmn:incoming>Flow_G2_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_G2_M1</bpmn:incoming>
      <bpmn:incoming>Flow_G1_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Xếp hàng đợi, tạo phiếu chấm mù theo vai trò">
      <bpmn:incoming>Flow_M1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_T4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T4" name="Gửi link phiếu cho chuyên gia">
      <bpmn:incoming>Flow_T3_T4</bpmn:incoming>
      <bpmn:incoming>Flow_T5b_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_M3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="M3" name="">
      <bpmn:incoming>Flow_T4_M3</bpmn:incoming>
      <bpmn:incoming>Flow_T5_M3</bpmn:incoming>
      <bpmn:outgoing>Flow_M3_EB</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="EB" name="">
      <bpmn:incoming>Flow_M3_EB</bpmn:incoming>
      <bpmn:outgoing>Flow_EB_IC1</bpmn:outgoing>
      <bpmn:outgoing>Flow_EB_IC2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IC1" name="Nhận đủ phiếu">
      <bpmn:incoming>Flow_EB_IC1</bpmn:incoming>
      <bpmn:outgoing>Flow_IC1_T6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_IC1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC2" name="Quá 7 ngày">
      <bpmn:incoming>Flow_EB_IC2</bpmn:incoming>
      <bpmn:outgoing>Flow_IC2_GR</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_IC2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GR" name="Đã nhắc&#10;2 lần?">
      <bpmn:incoming>Flow_IC2_GR</bpmn:incoming>
      <bpmn:outgoing>Flow_GR_T5</bpmn:outgoing>
      <bpmn:outgoing>Flow_GR_T5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T5" name="Nhắc chuyên gia">
      <bpmn:incoming>Flow_GR_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_M3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T5b" name="Mời chuyên gia khác">
      <bpmn:incoming>Flow_GR_T5b</bpmn:incoming>
      <bpmn:outgoing>Flow_T5b_T4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="T6" name="Tổng hợp phiếu, đánh dấu mâu thuẫn">
      <bpmn:incoming>Flow_IC1_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_G3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_T6_DS2">
        <bpmn:targetRef>DS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:dataStoreReference id="DS2" name="Kho Design Passport" dataStoreRef="Store_DS2" />
    <bpmn:exclusiveGateway id="G3" name="Có mâu thuẫn&#10;quy tắc?">
      <bpmn:incoming>Flow_T6_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_T7</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_M2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Xem lại phiếu mâu thuẫn, chốt kết luận">
      <bpmn:incoming>Flow_G3_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_M2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M2" name="">
      <bpmn:incoming>Flow_G3_M2</bpmn:incoming>
      <bpmn:incoming>Flow_T7_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_M2_G4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4" name="Kết luận?">
      <bpmn:incoming>Flow_M2_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_T8</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_E4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_T9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T8" name="Ghi lý do, mở lại để sửa">
      <bpmn:incoming>Flow_G4_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_E3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E3" name="Chờ chỉnh sửa">
      <bpmn:incoming>Flow_T8_E3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E4" name="Bị loại, đã ghi lý do">
      <bpmn:incoming>Flow_G4_E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="T9" name="Kiểm tra quyền xuất bản công khai">
      <bpmn:incoming>Flow_G4_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_G5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G5" name="Được&#10;xuất bản?">
      <bpmn:incoming>Flow_T9_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_T10</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_E6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T10" name="Xuất bản kèm nhãn AI, ghi công">
      <bpmn:incoming>Flow_G5_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_E5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E5" name="Đã xuất bản">
      <bpmn:incoming>Flow_T10_E5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E6" name="Đã phê duyệt, chờ giấy phép">
      <bpmn:incoming>Flow_G5_E6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T1" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_G1" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_E1" name="Không đạt" sourceRef="G1" targetRef="E1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval.status = qa_failed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_T2" name="Có cảnh báo" sourceRef="G1" targetRef="T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval.status = qa_warning</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T2_G2" name="" sourceRef="T2" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_E2" name="Trả về sửa" sourceRef="G2" targetRef="E2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = return_for_repair</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_M1" name="Chuyển chuyên gia" sourceRef="G2" targetRef="M1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = forward_to_expert</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_M1" name="Chờ chuyên gia hoặc được đề cử" sourceRef="G1" targetRef="M1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval.status = pending_expert_review</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M1_T3" name="" sourceRef="M1" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T3_T4" name="" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_T4_M3" name="" sourceRef="T4" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_M3_EB" name="" sourceRef="M3" targetRef="EB" />
    <bpmn:sequenceFlow id="Flow_EB_IC1" name="" sourceRef="EB" targetRef="IC1" />
    <bpmn:sequenceFlow id="Flow_EB_IC2" name="" sourceRef="EB" targetRef="IC2" />
    <bpmn:sequenceFlow id="Flow_IC2_GR" name="" sourceRef="IC2" targetRef="GR" />
    <bpmn:sequenceFlow id="Flow_GR_T5" name="Chưa" sourceRef="GR" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">số lần nhắc &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T5_M3" name="" sourceRef="T5" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_GR_T5b" name="Rồi" sourceRef="GR" targetRef="T5b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">số lần nhắc = 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T5b_T4" name="" sourceRef="T5b" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_IC1_T6" name="" sourceRef="IC1" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_G3" name="" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_T7" name="Có" sourceRef="G3" targetRef="T7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rule_conflict = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_M2" name="Không" sourceRef="G3" targetRef="M2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rule_conflict = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_M2" name="" sourceRef="T7" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_M2_G4" name="" sourceRef="M2" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_G4_T8" name="Cần sửa" sourceRef="G4" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">kết luận = revise</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G4_E4" name="Loại" sourceRef="G4" targetRef="E4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">kết luận = reject</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G4_T9" name="Đạt" sourceRef="G4" targetRef="T9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">kết luận = approve</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T8_E3" name="" sourceRef="T8" targetRef="E3" />
    <bpmn:sequenceFlow id="Flow_T9_G5" name="" sourceRef="T9" targetRef="G5" />
    <bpmn:sequenceFlow id="Flow_G5_T10" name="Có" sourceRef="G5" targetRef="T10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_gate(publish_public).allowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G5_E6" name="Không" sourceRef="G5" targetRef="E6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">quyền chưa cho phép xuất bản</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T10_E5" name="" sourceRef="T10" targetRef="E5" />
  </bpmn:process>
  <bpmn:process id="Proc_EXP" name="Hội đồng chuyên gia" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EXP">
      <bpmn:lane id="L_EXP" name="Chuyên gia di sản, thiết kế">
        <bpmn:flowNodeRef>ES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ET</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ES" name="Nhận link phiếu">
      <bpmn:outgoing>Flow_ES_ET</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ES" />
    </bpmn:startEvent>
    <bpmn:userTask id="ET" name="Chấm mù trên cổng thẩm định">
      <bpmn:incoming>Flow_ES_ET</bpmn:incoming>
      <bpmn:outgoing>Flow_ET_EE</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE" name="Gửi phiếu">
      <bpmn:incoming>Flow_ET_EE</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_EE" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ES_ET" name="" sourceRef="ES" targetRef="ET" />
    <bpmn:sequenceFlow id="Flow_ET_EE" name="" sourceRef="ET" targetRef="EE" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP03_TOBE" name="BP-03 TO-BE — Kiểm soát chất lượng, thẩm định và xuất bản">
    <bpmndi:BPMNPlane id="Plane_BP03_TOBE" bpmnElement="Collab_BP03_TOBE">
      <bpmndi:BPMNShape id="P_di" bpmnElement="P" isHorizontal="false">
        <dc:Bounds x="20" y="20" width="1032" height="2842" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_SYS_di" bpmnElement="L_SYS" isHorizontal="false">
        <dc:Bounds x="436" y="54" width="616" height="2808" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_QC_di" bpmnElement="L_QC" isHorizontal="false">
        <dc:Bounds x="20" y="54" width="416" height="2808" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S" color:background-color="#E1F3E4" color:border-color="#2E7D32">
        <dc:Bounds x="526" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="568" y="138" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1" color:background-color="#E1F3E4" color:border-color="#2E7D32">
        <dc:Bounds x="462" y="240" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_di" bpmnElement="DS" color:background-color="#FFFFFF" color:border-color="#455A64">
        <dc:Bounds x="719" y="261" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="688" y="315" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="false">
        <dc:Bounds x="499" y="369" width="90" height="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="407" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1" color:background-color="#E1F3E4" color:border-color="#2E7D32">
        <dc:Bounds x="726" y="524" width="36" height="36" />
        <bpmndi:BPMNLabel>
