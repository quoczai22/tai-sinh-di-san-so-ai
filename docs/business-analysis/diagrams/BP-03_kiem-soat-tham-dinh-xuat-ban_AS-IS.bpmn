<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP03_ASIS" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP03_ASIS" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:dataStore id="Store_DS" name="Kho Design Passport" />
  <bpmn:dataStore id="Store_DS2" name="Kho Design Passport" />
  <bpmn:collaboration id="Collab_BP03_ASIS">
    <bpmn:participant id="P" name="Nền tảng Tái Sinh Di Sản Số" processRef="Proc_P" />
    <bpmn:participant id="EXP" name="Hội đồng chuyên gia" processRef="Proc_EXP" />
    <bpmn:messageFlow id="Msg_T4_ES" name="Gói / link chấm mù" sourceRef="T4" targetRef="ES" />
    <bpmn:messageFlow id="Msg_EE_T5" name="Phiếu chấm (Google Form, Excel)" sourceRef="EE" targetRef="T5" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Nền tảng Tái Sinh Di Sản Số" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_QC" name="QC Officer (điều phối thẩm định)">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_API" name="API và kho Passport">
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Mở đợt thẩm định (thủ công)">
      <bpmn:outgoing>Flow_S_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Lấy danh sách thiết kế (GET /passports)">
      <bpmn:incoming>Flow_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_G1</bpmn:outgoing>
      <bpmn:property id="Prop_T1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Data_DS_T1">
        <bpmn:sourceRef>DS</bpmn:sourceRef>
        <bpmn:targetRef>Prop_T1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DS" name="Kho Design Passport" dataStoreRef="Store_DS" />
    <bpmn:exclusiveGateway id="G1" name="Trạng thái duyệt?">
      <bpmn:incoming>Flow_T1_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_E1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Không đưa đi thẩm định (qa_failed)">
      <bpmn:incoming>Flow_G1_E1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T2" name="Xem cảnh báo, ra quyết định QC (POST /qc)">
      <bpmn:incoming>Flow_G1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Quyết định QC?">
      <bpmn:incoming>Flow_T2_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_E2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Trả về sửa (qa_failed)">
      <bpmn:incoming>Flow_G2_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_G2_M1</bpmn:incoming>
      <bpmn:incoming>Flow_G1_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Lập gói chấm mù (build_blind_review / build_google_form)">
      <bpmn:incoming>Flow_M1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_T4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T4" name="Gửi link phiếu hoặc gói cho chuyên gia">
      <bpmn:incoming>Flow_T3_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_T5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="T5" name="Nhận phiếu chấm">
      <bpmn:incoming>Flow_T4_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="T6" name="Nhập kết quả vào Passport (POST /reviews)">
      <bpmn:incoming>Flow_T5_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_T7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T7" name="Ghi phiếu, đánh dấu mâu thuẫn với quy tắc đạt">
      <bpmn:incoming>Flow_T6_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_G3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_T7_DS2">
        <bpmn:targetRef>DS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Quyết định chuyên gia?">
      <bpmn:incoming>Flow_T7_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_E3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_E4</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_T8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Yêu cầu sửa (nhà thiết kế không được báo)">
      <bpmn:incoming>Flow_G3_E3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E4" name="Bị loại, đã ghi lý do">
      <bpmn:incoming>Flow_G3_E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS2" name="Kho Design Passport" dataStoreRef="Store_DS2" />
    <bpmn:userTask id="T8" name="Gọi xuất bản (POST /publish)">
      <bpmn:incoming>Flow_G3_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_T9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="T9" name="Kiểm tra quyền xuất bản công khai">
      <bpmn:incoming>Flow_T8_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_G4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G4" name="Được xuất bản?">
      <bpmn:incoming>Flow_T9_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_T10</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_E6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T10" name="Ghi sự kiện xuất bản">
      <bpmn:incoming>Flow_G4_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_E5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E5" name="Đã xuất bản">
      <bpmn:incoming>Flow_T10_E5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E6" name="Không xuất bản, chỉ dùng phi thương mại">
      <bpmn:incoming>Flow_G4_E6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T1" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_G1" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_E1" name="qa_failed" sourceRef="G1" targetRef="E1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval.status = qa_failed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_T2" name="qa_warning" sourceRef="G1" targetRef="T2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval.status = qa_warning</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T2_G2" name="" sourceRef="T2" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_E2" name="Trả về sửa" sourceRef="G2" targetRef="E2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = return_for_repair</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_M1" name="Chuyển chuyên gia" sourceRef="G2" targetRef="M1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = forward_to_expert</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G1_M1" name="Chờ chuyên gia" sourceRef="G1" targetRef="M1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval.status = pending_expert_review</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M1_T3" name="" sourceRef="M1" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T3_T4" name="" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_T4_T5" name="" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_T5_T6" name="" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_T7" name="" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_T7_G3" name="" sourceRef="T7" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_E3" name="Cần sửa" sourceRef="G3" targetRef="E3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = revise</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_E4" name="Loại" sourceRef="G3" targetRef="E4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = reject</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G3_T8" name="Đạt" sourceRef="G3" targetRef="T8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision = approve</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T8_T9" name="" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_T9_G4" name="" sourceRef="T9" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_G4_T10" name="Có" sourceRef="G4" targetRef="T10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_gate(publish_public).allowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G4_E6" name="Không" sourceRef="G4" targetRef="E6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">quyền chưa cho phép xuất bản</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T10_E5" name="" sourceRef="T10" targetRef="E5" />
  </bpmn:process>
  <bpmn:process id="Proc_EXP" name="Hội đồng chuyên gia" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EXP">
      <bpmn:lane id="L_EXP" name="Chuyên gia di sản, thiết kế">
        <bpmn:flowNodeRef>ES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ET</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ES" name="Nhận gói chấm mù">
      <bpmn:outgoing>Flow_ES_ET</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ES" />
    </bpmn:startEvent>
    <bpmn:userTask id="ET" name="Chấm mù 5 tiêu chí, chọn quyết định (Google Form hoặc phiếu)">
      <bpmn:incoming>Flow_ES_ET</bpmn:incoming>
      <bpmn:outgoing>Flow_ET_EE</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE" name="Gửi phiếu">
      <bpmn:incoming>Flow_ET_EE</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_EE" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ES_ET" name="" sourceRef="ES" targetRef="ET" />
    <bpmn:sequenceFlow id="Flow_ET_EE" name="" sourceRef="ET" targetRef="EE" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP03_ASIS" name="BP-03 AS-IS — Kiểm soát chất lượng, thẩm định và xuất bản">
    <bpmndi:BPMNPlane id="Plane_BP03_ASIS" bpmnElement="Collab_BP03_ASIS">
      <bpmndi:BPMNShape id="P_di" bpmnElement="P" isHorizontal="false">
        <dc:Bounds x="20" y="20" width="1032" height="2509" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_API_di" bpmnElement="L_API" isHorizontal="false">
        <dc:Bounds x="636" y="54" width="416" height="2475" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_QC_di" bpmnElement="L_QC" isHorizontal="false">
        <dc:Bounds x="20" y="54" width="616" height="2475" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="310" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="352" y="138" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1" color:background-color="#FFF4D6" color:border-color="#8A6100">
        <dc:Bounds x="246" y="240" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_di" bpmnElement="DS" color:background-color="#FFFFFF" color:border-color="#455A64">
        <dc:Bounds x="719" y="261" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="688" y="315" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true">
        <dc:Bounds x="303" y="389" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="199" y="437" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1">
        <dc:Bounds x="110" y="524" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="72" y="564" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2" color:background-color="#FFF4D6" color:border-color="#8A6100">
        <dc:Bounds x="446" y="496" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true">
        <dc:Bounds x="719" y="645" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="793" y="612" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2">
        <dc:Bounds x="926" y="780" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="888" y="820" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M1_di" bpmnElement="M1" isMarkerVisible="true">
        <dc:Bounds x="303" y="773" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3" color:background-color="#FFF4D6" color:border-color="#8A6100">
        <dc:Bounds x="246" y="880" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4" color:background-color="#E4EEF9" color:border-color="#1F5A99">
        <dc:Bounds x="246" y="1008" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5" color:background-color="#E4EEF9" color:border-color="#1F5A99">
        <dc:Bounds x="246" y="1341" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6" color:background-color="#FFF4D6" color:border-color="#8A6100">
        <dc:Bounds x="246" y="1469" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7" color:background-color="#E4EEF9" color:border-color="#1F5A99">
