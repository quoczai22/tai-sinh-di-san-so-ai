      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true">
        <dc:Bounds x="719" y="1746" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="654" y="1719" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3">
        <dc:Bounds x="926" y="1881" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="888" y="1921" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E4_di" bpmnElement="E4">
        <dc:Bounds x="726" y="1881" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="1879" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS2_di" bpmnElement="DS2" color:background-color="#FFFFFF" color:border-color="#455A64">
        <dc:Bounds x="919" y="1618" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="888" y="1672" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8" color:background-color="#FFF4D6" color:border-color="#8A6100">
        <dc:Bounds x="246" y="1853" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T9_di" bpmnElement="T9" color:background-color="#EEE8FA" color:border-color="#5A3E99">
        <dc:Bounds x="662" y="1981" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G4_di" bpmnElement="G4" isMarkerVisible="true">
        <dc:Bounds x="719" y="2130" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="774" y="2148" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T10_di" bpmnElement="T10" color:background-color="#E4EEF9" color:border-color="#1F5A99">
        <dc:Bounds x="662" y="2237" width="164" height="92" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E5_di" bpmnElement="E5">
        <dc:Bounds x="726" y="2393" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="2391" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E6_di" bpmnElement="E6">
        <dc:Bounds x="310" y="2265" width="36" height="36" />
