<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_BP04_TOBE" targetNamespace="https://tai-sinh-di-san-so/bpmn/BP04_TOBE" exporter="tsds-ba-kit" exporterVersion="2.0">
  <bpmn:dataStore id="Store_DS" name="Danh mục hiện vật" />
  <bpmn:collaboration id="Collab_BP04_TOBE">
    <bpmn:participant id="P" name="Nền tảng Tái Sinh Di Sản Số" processRef="Proc_P" />
    <bpmn:participant id="OWN" name="Chủ sở hữu ảnh" />
    <bpmn:messageFlow id="Msg_T5c_OWN" name="Lời nhắc" sourceRef="T5c" targetRef="OWN" />
    <bpmn:messageFlow id="Msg_T5_OWN" name="Đề nghị cấp phép" sourceRef="T5" targetRef="OWN" />
    <bpmn:messageFlow id="Msg_OWN_IC1" name="Phản hồi" sourceRef="OWN" targetRef="IC1" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P" name="Nền tảng Tái Sinh Di Sản Số" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P">
      <bpmn:lane id="L_DATA" name="Người quản lý dữ liệu">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Hệ thống tiếp nhận">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Có ảnh hoặc mô hình hiện vật mới">
      <bpmn:outgoing>Flow_S_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Chuẩn bị ảnh, khai báo nguồn, đơn vị lưu giữ">
      <bpmn:incoming>Flow_S_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_T2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Tiếp nhận: tách nền, kiểm tiêu chí C1–C4">
      <bpmn:incoming>Flow_T1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Đạt C1 và C2?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_T3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Đánh dấu loại, ghi lý do">
      <bpmn:incoming>Flow_G1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_E1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Không đưa vào thư viện">
      <bpmn:incoming>Flow_T3_E1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="T4" name="Xác định tình trạng quyền">
      <bpmn:incoming>Flow_G1_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_G2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G2" name="Tình trạng&#10;quyền?">
      <bpmn:incoming>Flow_T4_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_E2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T5</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Không được dùng">
      <bpmn:incoming>Flow_G2_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T5" name="Gửi đề nghị cấp phép">
      <bpmn:incoming>Flow_G2_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_T5b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T5b" name="Ghi trạng thái chờ cấp phép">
      <bpmn:incoming>Flow_T5_T5b</bpmn:incoming>
      <bpmn:outgoing>Flow_T5b_EB</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="EB" name="">
      <bpmn:incoming>Flow_T5b_EB</bpmn:incoming>
      <bpmn:incoming>Flow_T5c_EB</bpmn:incoming>
      <bpmn:outgoing>Flow_EB_IC1</bpmn:outgoing>
      <bpmn:outgoing>Flow_EB_IC2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IC1" name="Nhận phản hồi">
      <bpmn:incoming>Flow_EB_IC1</bpmn:incoming>
      <bpmn:outgoing>Flow_IC1_T6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_IC1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC2" name="Quá 14 ngày">
      <bpmn:incoming>Flow_EB_IC2</bpmn:incoming>
      <bpmn:outgoing>Flow_IC2_G3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_IC2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G3" name="Đã nhắc&#10;2 lần?">
      <bpmn:incoming>Flow_IC2_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_T5c</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_E3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T5c" name="Gửi lời nhắc">
      <bpmn:incoming>Flow_G3_T5c</bpmn:incoming>
      <bpmn:outgoing>Flow_T5c_EB</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T6" name="Ghi phản hồi vào biểu mẫu quyền">
      <bpmn:incoming>Flow_IC1_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_M1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Đóng đề nghị, giữ &#34;chưa xác minh&#34;">
      <bpmn:incoming>Flow_G3_E3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M1" name="">
      <bpmn:incoming>Flow_G2_M1</bpmn:incoming>
      <bpmn:incoming>Flow_T6_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_T7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T7" name="Ghi vào danh mục hiện vật">
      <bpmn:incoming>Flow_M1_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_T8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_T7_DS">
        <bpmn:targetRef>DS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DS" name="Danh mục hiện vật" dataStoreRef="Store_DS" />
    <bpmn:userTask id="T8" name="Viết mô tả, ý nghĩa hoa văn">
      <bpmn:incoming>Flow_T7_T8</bpmn:incoming>
      <bpmn:outgoing>Flow_T8_T9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T9" name="Tự xuất dữ liệu web và mô hình 3D">
      <bpmn:incoming>Flow_T8_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_E4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E4" name="Hiện vật có trên Studio">
      <bpmn:incoming>Flow_T9_E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T1" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_T2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_T2_G1" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_T3" name="Không" sourceRef="G1" targetRef="T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">C1 hoặc C2 = FAIL</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T3_E1" name="" sourceRef="T3" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_G1_T4" name="Có" sourceRef="G1" targetRef="T4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">C1, C2 không FAIL</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_G2" name="" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_E2" name="Bị từ chối" sourceRef="G2" targetRef="E2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_status = permission_denied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_T5" name="Chưa xác minh" sourceRef="G2" targetRef="T5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_status = unverified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_G2_M1" name="Đã có quyền" sourceRef="G2" targetRef="M1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rights_status ∈ publishable_statuses</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T5_T5b" name="" sourceRef="T5" targetRef="T5b" />
    <bpmn:sequenceFlow id="Flow_T5b_EB" name="" sourceRef="T5b" targetRef="EB" />
    <bpmn:sequenceFlow id="Flow_EB_IC1" name="" sourceRef="EB" targetRef="IC1" />
    <bpmn:sequenceFlow id="Flow_EB_IC2" name="" sourceRef="EB" targetRef="IC2" />
    <bpmn:sequenceFlow id="Flow_IC2_G3" name="" sourceRef="IC2" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_T5c" name="Chưa" sourceRef="G3" targetRef="T5c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">số lần nhắc &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T5c_EB" name="" sourceRef="T5c" targetRef="EB" />
    <bpmn:sequenceFlow id="Flow_G3_E3" name="Rồi" sourceRef="G3" targetRef="E3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">số lần nhắc = 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IC1_T6" name="" sourceRef="IC1" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_T6_M1" name="" sourceRef="T6" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_M1_T7" name="" sourceRef="M1" targetRef="T7" />
    <bpmn:sequenceFlow id="Flow_T7_T8" name="" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="Flow_T8_T9" name="" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_T9_E4" name="" sourceRef="T9" targetRef="E4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BP04_TOBE" name="BP-04 TO-BE — Tiếp nhận hiện vật và quản lý quyền sử dụng">
